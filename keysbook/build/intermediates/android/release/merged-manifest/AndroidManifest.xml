<?xml version="1.0" encoding="utf-8"?>
<manifest package="com.keysbook.app" xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <application android:allowBackup="true" android:icon="@mipmap/ic_launcher" android:label="@string/app_name" android:supportsRtl="true" android:usesCleartextTraffic="true" android:theme="@style/Theme.KeysBook">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity android:name=".KeysActivity" android:exported="false" android:label="@string/keys_title"/>
        <activity android:name=".EditKeyActivity" android:exported="false" android:label="@string/new_key" android:windowSoftInputMode="adjustResize"/>
        <activity android:name=".ModelsActivity" android:exported="false" android:label="@string/models_label"/>
    </application>
</manifest>
